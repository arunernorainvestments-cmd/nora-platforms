{
  "version": 2,
  "buildCommand": null,
  "framework": null,
  "rewrites": [
    { "source": "/privacy",             "destination": "/privacy.html"             },
    { "source": "/terms",               "destination": "/terms.html"               },
    { "source": "/tiktok-verification", "destination": "/tiktok-verification.html" },
    { "source": "/home",                "destination": "/home/index.html"          },
    { "source": "/home/(.*)",           "destination": "/home/index.html"          },
    { "source": "/((?!privacy|terms|tiktok-verification|home).*)", "destination": "/index.html" }
  ]
}
